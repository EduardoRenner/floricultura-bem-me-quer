# Copie para .env e preencha. O .env NUNCA vai para o git (ver .gitignore).

# --- Público (vai para o bundle do browser) ---
# Só a publishable key pode aparecer aqui. Ela é protegida por RLS.
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-id>
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- Servidor (nunca chega ao browser) ---
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PROJECT_ID=<project-id>
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# ATENÇÃO: chave de service role — ignora RLS por completo.
# Só é lida em src/integrations/supabase/client.server.ts, que roda apenas no
# servidor. Nunca prefixe com VITE_ (isso a injetaria no bundle do cliente) e
# nunca a imprima em log.
# Onde achar: Supabase Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
