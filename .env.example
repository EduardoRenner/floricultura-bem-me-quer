# Copie para .env e preencha. O .env NUNCA vai para o git (ver .gitignore).

# --- Público (vai para o bundle do browser) ---
# Só a publishable key pode aparecer aqui. Ela é protegida por RLS.
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-id>
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- Servidor (nunca chega ao browser) ---
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PROJECT_ID=<project-id>
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# ATENÇÃO: chave de service role — ignora RLS por completo.
# Só é lida em src/integrations/supabase/client.server.ts, que roda apenas no
# servidor. Nunca prefixe com VITE_ (isso a injetaria no bundle do cliente) e
# nunca a imprima em log.
# Onde achar: Supabase Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Domínio público definitivo do site (sem barra no final). Usado só no
# servidor, para montar a logo e o link do QR code de confirmação de entrega
# dentro do PDF gerado ao fechar o pedido. Se não definido, cai para
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL (que a própria Vercel injeta),
# mas essas podem não bater com o domínio customizado — prefira definir esta.
SITE_URL=https://<seu-dominio-em-producao>

# Segredo do HMAC que assina o token de sessão do painel admin.
# Sem ele, o login do /admin lança erro em vez de autenticar.
# Gere um valor aleatório longo (ex.: openssl rand -base64 48).
ADMIN_SESSION_SECRET=
